# Lista blanca: el repositorio remoto solo publica las plantillas y la
# documentación. Todo el contenido de las materias queda solo en local.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/.env.example
!/requirements.txt
!/LICENSE
!/_plantillas/
!/tests/
!/.github/

# Artefactos de Python y copias de seguridad de `tareas.py esqueleto --forzar`
__pycache__/
*.pyc
.venv/
venv/
*.py.bak

# Archivos temporales del sistema
.DS_Store
Thumbs.db
