# Copia este archivo como .env y rellena tus datos:  cp .env.example .env
# El .env no se sube al repositorio (está en .gitignore).

# Portada de los documentos
NOMBRE_ESTUDIANTE="Nombre Completo del Estudiante"
INSTITUCION="Nombre de la Institución"
CARRERA="Carrera de ..."

# Se añade al final de cada entregable: A15_Titulo_<SUFIJO_ARCHIVOS>.docx
SUFIJO_ARCHIVOS="Apellido_Nombre"

# --- Opcional: extensión y profundidad por defecto -------------------------
# Sin estas líneas no hay límite de páginas y el esqueleto usa ~1500 palabras.
# Lo que diga la tarea (campos Extensión y Profundidad de TAREA.md) manda.
#
# Nivel académico (informativo, para el tono de los agentes): instituto, universidad, posgrado...
# NIVEL_ACADEMICO="instituto"
# Cuánto se elabora el documento: basica | media | alta
#   basica: fundamentos breves, explicación aplicada, 3 referencias como mínimo
#   media:  una sección de fundamentos y decisiones justificadas, 4 referencias
#   alta:   contraste de fuentes, alternativas y limitaciones, 8 referencias
# PROFUNDIDAD="basica"
# Páginas máximas del PDF, contando portada y referencias (tipo proyecto aparte)
# PAGINAS_MAX_TAREA=10
# PAGINAS_MAX_PROYECTO=20
